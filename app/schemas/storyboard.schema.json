{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "summary",
    "learning_objective",
    "closing_takeaway",
    "scenes"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 3 },
    "summary": { "type": "string", "minLength": 12 },
    "learning_objective": { "type": "string", "minLength": 10 },
    "closing_takeaway": { "type": "string", "minLength": 10 },
    "scenes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "headline",
          "narration",
          "layout",
          "visual_goal",
          "key_points",
          "visual_items",
          "highlight_terms",
          "equations",
          "takeaway"
        ],
        "properties": {
          "slug": { "type": "string", "minLength": 2 },
          "headline": { "type": "string", "minLength": 3, "maxLength": 60 },
          "hook": { "type": "string", "minLength": 0, "maxLength": 70 },
          "narration": { "type": "string", "minLength": 30, "maxLength": 320 },
          "layout": {
            "type": "string",
            "enum": [
              "auto",
              "title_card",
              "summary",
              "thanks",
              "bullets",
              "statement",
              "equation",
              "step_derivation",
              "distribution",
              "axes_plot",
              "line_chart",
              "comparison",
              "before_after",
              "flow",
              "timeline",
              "bar_chart",
              "proportional_chart",
              "cause_effect",
              "network"
            ]
          },
          "visual_goal": { "type": "string", "minLength": 8 },
          "key_points": {
            "type": "array",
            "maxItems": 5,
            "items": { "type": "string", "minLength": 4, "maxLength": 90 }
          },
          "visual_items": {
            "type": "array",
            "maxItems": 5,
            "items": { "type": "string", "minLength": 2, "maxLength": 40 }
          },
          "highlight_terms": {
            "type": "array",
            "maxItems": 5,
            "items": { "type": "string", "minLength": 2, "maxLength": 24 }
          },
          "equations": {
            "type": "array",
            "maxItems": 6,
            "items": { "type": "string", "maxLength": 80 }
          },
          "data_points": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "value"],
              "properties": {
                "label": { "type": "string", "minLength": 1, "maxLength": 28 },
                "value": { "type": "number" }
              }
            }
          },
          "takeaway": { "type": "string", "minLength": 0, "maxLength": 90 }
        }
      }
    }
  }
}
