{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "summary",
    "learning_objective",
    "closing_takeaway",
    "category",
    "quiz",
    "scenes"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 3, "maxLength": 40 },
    "summary": { "type": "string", "minLength": 12 },
    "learning_objective": { "type": "string", "minLength": 10 },
    "closing_takeaway": { "type": "string", "minLength": 10 },
    "category": {
      "type": "string",
      "enum": [
        "CS & ML",
        "Statistics & probability",
        "Calculus",
        "Linear algebra",
        "Physics",
        "Chemistry",
        "Biology",
        "Other"
      ]
    },
    "quiz": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questions"],
      "properties": {
        "questions": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["prompt", "choices", "answer"],
            "properties": {
              "prompt": { "type": "string", "minLength": 12, "maxLength": 180 },
              "choices": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": { "type": "string", "minLength": 1, "maxLength": 120 }
              },
              "answer": { "type": "integer", "minimum": 0, "maximum": 3 }
            }
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "headline",
          "narration",
          "layout",
          "visual_goal",
          "key_points",
          "visual_items",
          "highlight_terms",
          "equations",
          "takeaway"
        ],
        "properties": {
          "slug": { "type": "string", "minLength": 2 },
          "headline": { "type": "string", "minLength": 3, "maxLength": 48 },
          "hook": { "type": "string", "minLength": 0, "maxLength": 70 },
          "narration": { "type": "string", "minLength": 30, "maxLength": 320 },
          "layout": {
            "type": "string",
            "enum": [
              "auto",
              "title_card",
              "summary",
              "thanks",
              "statement",
              "equation",
              "step_derivation",
              "line_chart",
              "comparison",
              "before_after",
              "flow",
              "timeline",
              "bar_chart",
              "proportional_chart",
              "cause_effect",
              "network"
            ]
          },
          "visual_goal": { "type": "string", "minLength": 8 },
          "key_points": {
            "type": "array",
            "maxItems": 8,
            "items": { "type": "string", "minLength": 4, "maxLength": 100 }
          },
          "visual_items": {
            "type": "array",
            "maxItems": 6,
            "items": { "type": "string", "minLength": 2, "maxLength": 48 }
          },
          "highlight_terms": {
            "type": "array",
            "maxItems": 6,
            "items": { "type": "string", "minLength": 2, "maxLength": 30 }
          },
          "equations": {
            "type": "array",
            "maxItems": 8,
            "items": { "type": "string", "maxLength": 100 }
          },
          "data_points": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "value"],
              "properties": {
                "label": { "type": "string", "minLength": 1, "maxLength": 28 },
                "value": { "type": "number" }
              }
            }
          },
          "takeaway": { "type": "string", "minLength": 0, "maxLength": 80 }
        }
      }
    }
  }
}
