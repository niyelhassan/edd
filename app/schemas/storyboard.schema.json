{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "summary",
    "learning_objective",
    "closing_takeaway",
    "visual_theme",
    "scenes"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 3
    },
    "summary": {
      "type": "string",
      "minLength": 12
    },
    "learning_objective": {
      "type": "string",
      "minLength": 10
    },
    "closing_takeaway": {
      "type": "string",
      "minLength": 10
    },
    "visual_theme": {
      "type": "string",
      "enum": [
        "blueprint",
        "chalk",
        "lab",
        "signal",
        "midnight",
        "sunset"
      ]
    },
    "scenes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "headline",
          "hook",
          "narration",
          "layout",
          "scene_variant",
          "visual_goal",
          "key_points",
          "visual_items",
          "highlight_terms",
          "equations",
          "takeaway"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 2
          },
          "headline": {
            "type": "string",
            "minLength": 3,
            "maxLength": 60
          },
          "hook": {
            "type": "string",
            "minLength": 0,
            "maxLength": 70
          },
          "narration": {
            "type": "string",
            "minLength": 45,
            "maxLength": 420
          },
          "layout": {
            "type": "string",
            "enum": [
              "auto",
              "concept_map",
              "equation",
              "comparison",
              "axes",
              "timeline",
              "flow",
              "orbit",
              "matrix",
              "distribution",
              "geometry",
              "vector",
              "bridge",
              "feedback",
              "lab"
            ]
          },
          "scene_variant": {
            "type": "string",
            "enum": [
              "auto",
              "hero_reveal",
              "concept_network",
              "equation_build",
              "graph_discovery",
              "before_after",
              "process_flow",
              "timeline_story",
              "orbit_system",
              "lab_experiment",
              "probability_grid",
              "distribution_curve",
              "geometry_proof",
              "vector_field",
              "feedback_loop",
              "research_bridge"
            ]
          },
          "visual_goal": {
            "type": "string",
            "minLength": 12
          },
          "key_points": {
            "type": "array",
            "minItems": 0,
            "maxItems": 3,
            "items": {
              "type": "string",
              "minLength": 5,
              "maxLength": 90
            }
          },
          "visual_items": {
            "type": "array",
            "minItems": 0,
            "maxItems": 5,
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 48
            }
          },
          "highlight_terms": {
            "type": "array",
            "minItems": 0,
            "maxItems": 5,
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 28
            }
          },
          "equations": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "string",
              "maxLength": 60
            }
          },
          "takeaway": {
            "type": "string",
            "minLength": 0,
            "maxLength": 90
          }
        }
      }
    }
  }
}
